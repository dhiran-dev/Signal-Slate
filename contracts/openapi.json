{
  "components": {
    "schemas": {
      "CandidateAction": {
        "additionalProperties": false,
        "description": "Specific corrective intervention applied to microphone configuration.",
        "properties": {
          "action_type": {
            "enum": [
              "CHANNEL_SWITCH",
              "ANTENNA_SWITCH",
              "BOOM_COVERAGE",
              "NO_ACTION"
            ],
            "title": "Action Type",
            "type": "string"
          },
          "mic_id": {
            "title": "Mic Id",
            "type": "string"
          },
          "parameters": {
            "additionalProperties": true,
            "title": "Parameters",
            "type": "object"
          }
        },
        "required": [
          "action_type",
          "mic_id",
          "parameters"
        ],
        "title": "CandidateAction",
        "type": "object"
      },
      "CandidatePlan": {
        "additionalProperties": false,
        "description": "Proposed corrective plan with explicit hash binding.",
        "properties": {
          "action_hash": {
            "title": "Action Hash",
            "type": "string"
          },
          "actions": {
            "items": {
              "$ref": "#/components/schemas/CandidateAction"
            },
            "title": "Actions",
            "type": "array"
          },
          "base_config_hash": {
            "title": "Base Config Hash",
            "type": "string"
          },
          "constraints_hash": {
            "title": "Constraints Hash",
            "type": "string"
          },
          "plan_id": {
            "title": "Plan Id",
            "type": "string"
          },
          "plan_version": {
            "default": 1,
            "title": "Plan Version",
            "type": "integer"
          },
          "rationale": {
            "title": "Rationale",
            "type": "string"
          },
          "tradeoffs": {
            "items": {
              "type": "string"
            },
            "title": "Tradeoffs",
            "type": "array"
          }
        },
        "required": [
          "plan_id",
          "actions",
          "action_hash",
          "constraints_hash",
          "base_config_hash",
          "rationale"
        ],
        "title": "CandidatePlan",
        "type": "object"
      },
      "Command": {
        "additionalProperties": false,
        "properties": {
          "approval": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PlanApproval"
              },
              {
                "type": "null"
              }
            ]
          },
          "constraints": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/Constraint"
                },
                "maxItems": 10,
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Constraints"
          },
          "revision": {
            "minimum": 0.0,
            "title": "Revision",
            "type": "integer"
          },
          "text": {
            "anyOf": [
              {
                "maxLength": 2000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Text"
          }
        },
        "required": [
          "revision"
        ],
        "title": "Command",
        "type": "object"
      },
      "Constraint": {
        "additionalProperties": false,
        "description": "Creative constraint discovered or confirmed by human operator.",
        "properties": {
          "confirmed": {
            "default": false,
            "title": "Confirmed",
            "type": "boolean"
          },
          "constraint_id": {
            "title": "Constraint Id",
            "type": "string"
          },
          "exact_source_span": {
            "title": "Exact Source Span",
            "type": "string"
          },
          "kind": {
            "enum": [
              "CHANNEL_EXCLUSION",
              "RIG_LOCK",
              "ANTENNA_LOCK",
              "BOOM_EXCLUSION",
              "CUSTOM"
            ],
            "title": "Kind",
            "type": "string"
          },
          "parameters": {
            "additionalProperties": true,
            "title": "Parameters",
            "type": "object"
          },
          "source_text": {
            "title": "Source Text",
            "type": "string"
          },
          "target_mic": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Target Mic"
          }
        },
        "required": [
          "constraint_id",
          "kind",
          "parameters",
          "exact_source_span",
          "source_text"
        ],
        "title": "Constraint",
        "type": "object"
      },
      "ConstraintInterpretation": {
        "additionalProperties": false,
        "description": "Output of Gemini constraint parsing from human natural text.",
        "properties": {
          "constraints": {
            "items": {
              "$ref": "#/components/schemas/Constraint"
            },
            "title": "Constraints",
            "type": "array"
          },
          "rationale": {
            "title": "Rationale",
            "type": "string"
          },
          "status": {
            "enum": [
              "SUPPORTED",
              "AMBIGUOUS",
              "CONTRADICTORY",
              "UNSUPPORTED"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "constraints",
          "rationale"
        ],
        "title": "ConstraintInterpretation",
        "type": "object"
      },
      "CreateSession": {
        "additionalProperties": false,
